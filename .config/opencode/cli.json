{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "mouse": true,
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default",
    "sounds": {
      "error": "./sounds/error.mp3"
    }
  },
  "prompt": {
    "image_preview": true
  },
  "keybinds": {
    "leader": "ctrl+z",
    "command.palette.show": "ctrl+p",
    "session.tab.next": "ctrl+tab,alt+down",
    "session.tab.previous": "ctrl+shift+tab,alt+up",
    "session.tab.select.1": "ctrl+1,<leader>1",
    "session.tab.select.2": "ctrl+2,<leader>2",
    "session.tab.close": "ctrl+w,<leader>w",
    "session.tab.reopen": "ctrl+shift+t",
    "input.delete.word.backward": "ctrl+backspace,alt+backspace"
  },
  "leader": {
    "timeout": 2250
  },
  "tabs": {
    "indicators": "status",
    "scope": "cwd",
    "layout": "horizontal"
  }
}
